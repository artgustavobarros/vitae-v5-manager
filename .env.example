DATABASE_URL="postgresql://v5:v5@localhost:5434/v5_manager"

# URL pública do app; a origem dela é a única confiável por padrão. Em produção, o domínio com https.
BETTER_AUTH_URL=http://localhost:3005
# Origens extras aceitas pelo login, separadas por vírgula. Opcional.
# BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3005
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mail Google do Narrador. Só ele entra sem Convite para a Crônica.
NARRADOR_EMAIL=

# Google Cloud Console > OAuth Client ID (Web).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produção (docker-compose.prod.yml): gere a senha com `openssl rand -hex 32`.
# Ela deve conter apenas letras e números porque compõe a DATABASE_URL do Compose.
# APP_HOST=vitae.artbarros.tech
# POSTGRES_PASSWORD=
# BETTER_AUTH_SECRET=
